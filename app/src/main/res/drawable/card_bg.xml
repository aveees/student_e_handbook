<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- GRADIENT -->
    <gradient
        android:angle="90"
        android:startColor="#D6F5C6"
        android:endColor="#A8E18F" />

    <!-- BORDER COLOR + WIDTH -->
    <stroke
        android:width="2dp"
        android:color="#0A4D0A" /> <!-- Dark Green -->

    <!-- CORNER RADIUS -->
    <corners android:radius="20dp" />

    <!-- PADDING -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
