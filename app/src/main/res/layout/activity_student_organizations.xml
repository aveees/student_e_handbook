<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DFF0D8">

    <!-- Fixed Header -->
    <include
        android:id="@+id/header_section"
        layout="@layout/layout_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <!-- Student Organizations and Activities Section -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_corners"
                android:gravity="center_horizontal">

                <!-- Title -->
                <TextView
                    android:id="@+id/student_org_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STUDENT ORGANIZATIONS AND ACTIVITIES"
                    android:textColor="#064c24"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_extra_bold"
                    android:layout_marginBottom="8dp"
                    android:textAlignment="center" />

                <!-- Description -->
                <TextView
                    android:id="@+id/student_org_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bulacan State University is providing relevant formation to students in both academic and non-academic spheres of student development. Student activities that are integrated within one‟s participation in student organizations foster and enhance relevant skills and talents responsive to the imminent call for nation building."
                    android:textColor="#064c24"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:lineSpacingExtra="4dp"
                    android:textAlignment="textStart"/>
            </LinearLayout>
            <!-- Objectives of OSOA Section -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_corners"
                android:gravity="center_horizontal">

                <!-- Title -->
                <TextView
                    android:id="@+id/osoa_objectives_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Objectives of the Office of Student Organizations and Activities"
                    android:textColor="#064c24"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_extra_bold"
                    android:layout_marginBottom="8dp"
                    android:textAlignment="center" />

                <!-- Description Intro -->
                <TextView
                    android:id="@+id/osoa_objectives_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The Office of the Student Organizations and Activities (OSOA) envisions molding student leadership in organized groups by designing co-curricular activities and providing opportunities for individual and collective recognition. Objectives include:"
                    android:textColor="#064c24"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="8dp"
                    android:textAlignment="textStart"/>

                <!-- Objectives List -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">

                    <!-- Objective 1 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="To educate the people and inculcate in their minds the sense of nationalism and cultural consciousness and enthusiasm through performing arts and literary arts."
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Objective 2 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="To bring a significant message that will suffice the sociological, psychological, moral and spiritual needs of man."
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Objective 3 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="To use and enhance the artistic skills of students, faculty members, personnel and staff in the field of arts."
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Objective 4 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="To instill in the hearts of the students the aesthetic values of the arts through performances, visuals and literary."
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Objective 5 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="To provide workshop, seminar, training and other benefits to deserving members of political, cultural and religious organizations on the basis of their needs and qualifications."
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <!-- Functions of OSOA Section -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_corners"
                android:gravity="center_horizontal">

                <!-- Title -->
                <TextView
                    android:id="@+id/osoa_functions_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Functions of the Office"
                    android:textColor="#064c24"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_extra_bold"
                    android:layout_marginBottom="8dp"
                    android:textAlignment="center" />

                <!-- Description Intro -->
                <TextView
                    android:id="@+id/osoa_functions_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The Office of Student Organizations and Activities (OSOA) performs the following functions:"
                    android:textColor="#064c24"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="8dp"
                    android:textAlignment="textStart"/>

                <!-- Functions List -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">

                    <!-- Function 1 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Initiates academic and non-academic activities that will help develop the leadership skills and potentials of students;"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Function 2 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Coordinates the programs, projects and activities of the different recognized student organizations;"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Function 3 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Plans, supervises and evaluates all co-curricular and extra-curricular undertakings of the students;"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Function 4 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Helps promote closer relations among faculty members, administration officials, non-academic personnel, and students;"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Function 5 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Initiates activities that will lead to the formulation of policies for the general welfare and interest of students;"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Function 6 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Develops information system on student organizations, activities and development;"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Function 7 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Evaluates and recommends student organization for accreditation and recognition, suspension of operation or disestablishment;"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Function 8 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Evaluates and awards outstanding organizations;"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Function 9 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Performs other functions as may be assigned to him/her"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <!-- Services Offered Section -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_corners"
                android:gravity="center_horizontal">

                <!-- Title -->
                <TextView
                    android:id="@+id/osoa_services_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Services Offered"
                    android:textColor="#064c24"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_extra_bold"
                    android:layout_marginBottom="8dp"
                    android:textAlignment="center" />

                <!-- Description Intro -->
                <TextView
                    android:id="@+id/osoa_services_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The OSOA provides the following services:"
                    android:textColor="#064c24"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="8dp"
                    android:textAlignment="textStart"/>

                <!-- Services List -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">

                    <!-- Service 1 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Advising Support: The OSOA staff is available on an appointment basis to provide assistance to student organization leaders and University adviser on organizational, leadership and programming issues. OSOA can also assist the organization in looking for possible and available student organization advisers."
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Service 2 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Leadership Skills Development: The OSOA offers a variety of workshops and programs designed to help student organization members develop better organizational and leadership skills. OSOA has the mandate to empower students by seeking and providing opportunities for holistic leadership formation such as regional, national and international fora and competitions."
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Service 3 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Data Banking of Student Organization List: The OSOA maintains a database of all current recognized Universitywide and College Organizations including files and documents of their respective accomplishment and financial reports. Although information regarding these documents can be obtained by the public, it is also important to seek first the permission of OSOA and the organization concerned through a formal written request."
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <!-- BulSU-OSO Executive Board Services Section -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_corners"
                android:gravity="center_horizontal">

                <!-- Main Title -->
                <TextView
                    android:id="@+id/oso_eb_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BulSU-OSO Executive Board"
                    android:textColor="#064c24"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_extra_bold"
                    android:layout_marginBottom="8dp"
                    android:textAlignment="center" />

                <!-- Description Intro -->
                <TextView
                    android:id="@+id/oso_eb_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="The Core group’s function is to help the office in planning, monitoring, executing and sourcing funds in all its activities for the whole year. Indeed, the success of the office’s activities is attributed to these young people who share their talents and fresh ideas without reservation."
                    android:textColor="#064c24"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="8dp"
                    android:textAlignment="textStart"/>

                <!-- Subtitle: Services Offered -->
                <TextView
                    android:id="@+id/oso_eb_services_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Services Offered by OSO-EB"
                    android:textColor="#064c24"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_bold"
                    android:layout_marginBottom="8dp"
                    android:textAlignment="textStart"/>

                <!-- Services List -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">

                    <!-- Service 1 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Leadership training and other capability building activities for officers and members of student organizations;"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Service 2 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Consultancy services to student organizations for their organizational development;"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Service 3 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Information services about organizing student organizations;"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Service 4 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Recognition and accreditation of student organization;"
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>

                    <!-- Service 5 -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="8dp"
                            android:src="@drawable/ic_arrow_right" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Evaluation and distribution of awards for outstanding student organizations and leaders."
                            android:textColor="#064c24"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat_medium"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Logos at Bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginVertical="10dp">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/bustos_logo"
            android:contentDescription="Bustos Logo"
            android:layout_marginEnd="16dp" />

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/eagles_logo"
            android:contentDescription="Eagles Logo" />
    </LinearLayout>

</LinearLayout>
