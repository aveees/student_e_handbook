<?xml version="1.0" encoding="utf-8"?>
<!-- Change the root to RelativeLayout -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:layout_margin="8dp"
    android:background="@drawable/rounded_corners">

    <LinearLayout
        android:id="@+id/schedule_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toStartOf="@+id/iv_delete_schedule"
        android:layout_alignParentStart="true">

        <TextView
            android:id="@+id/tv_subject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subject Name"
            android:textSize="18sp"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#064c24"/>

        <TextView
            android:id="@+id/tv_professor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prof. Name"
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_medium_italic"
            android:textColor="#064c24"/>

        <TextView
            android:id="@+id/tv_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Day"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_medium"
            android:textColor="#064c24"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:00 AM - 10:30 AM"
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_medium"
            android:textColor="#064c24"/>

        <TextView
            android:id="@+id/tv_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Room: C-304"
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_medium"
            android:textColor="#064c24"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_delete_schedule"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_delete"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:padding="8dp"
        android:contentDescription="Delete Schedule"
        android:background="?attr/selectableItemBackgroundBorderless"/>

</RelativeLayout>
