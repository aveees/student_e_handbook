<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#DFF0D8"
    tools:context=".CoedCurriculumFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card 1: BSED Major in English -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corners"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Program Curriculum"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#064c24"
                android:textSize="20sp" />

            <!-- Subtitle with course name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BSED Major in English"
                android:fontFamily="@font/montserrat_medium"
                android:textColor="#0a6b32"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <!-- Download Button -->
            <Button
                android:id="@+id/btn_download_bsed_english"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Download"
                android:backgroundTint="#064c24"
                android:textColor="@android:color/white"
                app:icon="@drawable/download"
                app:iconPadding="8dp"
                app:iconTint="@android:color/white"
                android:layout_gravity="end"/>
        </LinearLayout>

        <!-- Card 2: BSED Major in Mathematics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corners"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Program Curriculum"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#064c24"
                android:textSize="20sp" />

            <!-- Subtitle with course name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BSED Major in Mathematics"
                android:fontFamily="@font/montserrat_medium"
                android:textColor="#0a6b32"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <!-- Download Button -->
            <Button
                android:id="@+id/btn_download_bsed_math"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Download"
                android:backgroundTint="#064c24"
                android:textColor="@android:color/white"
                app:icon="@drawable/download"
                app:iconPadding="8dp"
                app:iconTint="@android:color/white"
                android:layout_gravity="end"/>
        </LinearLayout>

        <!-- Card 3: BSED Major in Science -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corners"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Program Curriculum"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#064c24"
                android:textSize="20sp" />

            <!-- Subtitle with course name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BSED Major in Science"
                android:fontFamily="@font/montserrat_medium"
                android:textColor="#0a6b32"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <!-- Download Button -->
            <Button
                android:id="@+id/btn_download_bsed_science"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Download"
                android:backgroundTint="#064c24"
                android:textColor="@android:color/white"
                app:icon="@drawable/download"
                app:iconPadding="8dp"
                app:iconTint="@android:color/white"
                android:layout_gravity="end"/>
        </LinearLayout>

        <!-- Card 4: BSED Major in Social Studies -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_corners"
            android:padding="20dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Program Curriculum"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#064c24"
                android:textSize="20sp" />

            <!-- Subtitle with course name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BSED Major in Social Studies"
                android:fontFamily="@font/montserrat_medium"
                android:textColor="#0a6b32"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <!-- Download Button -->
            <Button
                android:id="@+id/btn_download_bsed_socsci"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Download"
                android:backgroundTint="#064c24"
                android:textColor="@android:color/white"
                app:icon="@drawable/download"
                app:iconPadding="8dp"
                app:iconTint="@android:color/white"
                android:layout_gravity="end"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
