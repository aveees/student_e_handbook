<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#DFF0D8"
    tools:context=".AddEditScheduleActivity">

    <include
        android:id="@+id/header_section"
        layout="@layout/layout_section_header" />

    <EditText
        android:id="@+id/et_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Subject Name (e.g., IT 301)"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/et_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Day (e.g., Monday)"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <!-- CHANGE: EditText to TextView for Start Time -->
        <TextView
            android:id="@+id/tv_start_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Select Start Time"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="@drawable/edit_text_background"
            android:layout_marginEnd="4dp"
            android:gravity="center"/>

        <!-- CHANGE: EditText to TextView for End Time -->
        <TextView
            android:id="@+id/tv_end_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Select End Time"
            android:textSize="16sp"
            android:padding="12dp"
            android:background="@drawable/edit_text_background"
            android:layout_marginStart="4dp"
            android:gravity="center"/>
    </LinearLayout>

    <EditText
        android:id="@+id/et_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Room (e.g., C-304)"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/et_professor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Professor Name"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_save_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Class"
        android:backgroundTint="#064c24"
        android:layout_marginTop="24dp" />

</LinearLayout>
